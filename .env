# ------------------------------------------------------------------
# Genel ayarlar
# ------------------------------------------------------------------
APP_NAME=Akademi Sınıf Randevu
TIMEZONE=Europe/Istanbul

# Virgülle ayrılmış sınıf adları (3 sınıf)
CLASSROOMS=Sınıf A,Sınıf B,Sınıf C

# Çalışma saatleri ve randevu aralığı
OPEN_TIME=09:00
CLOSE_TIME=21:00
SLOT_MINUTES=30

# Randevuya bu kadar günden az kaldıysa düzenleme kilitlenir (3 gün = 72 saat)
LOCK_DAYS=3

# Silmeyi de kilitlemek isterseniz gün sayısı yazın (0 = her zaman silinebilir)
BLOCK_DELETE_WITHIN_DAYS=0

# Kaç gün sonrasına kadar randevu alınabilir
BOOKING_HORIZON_DAYS=90

# Kaç saat kala hatırlatma e-postası gönderilsin (virgülle)
REMINDER_HOURS=24,2

# Uygulamanın dış adresi (e-postalardaki bağlantılar için)
BASE_URL=http://127.0.0.1:8000

# Yönetim paneli şifresi (/admin)
ADMIN_PASSWORD=admin123

# Veritabanı dosyası
DATABASE_FILE=data/randevu.db

# ------------------------------------------------------------------
# E-posta gönderimi (SMTP)
# Boş bırakılırsa e-postalar gönderilmez, logs/outbox klasörüne .eml
# dosyası olarak yazılır (demo modu).
# Gmail için: uygulama şifresi oluşturun ve SMTP_TLS=true kullanın.
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Akademi Randevu <randevu@example.com>
SMTP_TLS=true
